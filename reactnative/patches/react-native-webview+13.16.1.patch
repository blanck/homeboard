+    private static Set<String> blockedHosts(android.content.Context context) {
+        if (sBlockedHosts == null) {
+            Set<String> hosts = new HashSet<>();
+            try (BufferedReader reader = new BufferedReader(new InputStreamReader(context.getAssets().open("blocked-hosts.txt")))) {
+                String line;
+                while ((line = reader.readLine()) != null) {
+                    line = line.trim();
+                    if (!line.isEmpty() && !line.startsWith("#")) hosts.add(line);
+                }
+            } catch (IOException ignored) {
+            }
+            sBlockedHosts = hosts;
+        }
+        return sBlockedHosts;
+    }
